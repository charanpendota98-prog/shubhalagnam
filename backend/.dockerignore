# Never bake credentials, local environments, or mutable member data into an image.
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.git/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Tests, synthetic fixture data, and one-off audit/live-write tools are not runtime dependencies.
test_*.py
*_test.py
testutil_*.py
test_fixtures/
assault*.py
audit_full_system.py
e2e_referral_*.py
verify_live_flow.py

