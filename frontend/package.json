{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:links": "node scripts/check-links.mjs",
    "test:security": "node --test scripts/safe-media-path.test.mjs scripts/match-filter-query.test.mjs scripts/match-results.test.mjs",
    "test:design": "node --test scripts/design-system.test.mjs",
    "test:a11y": "node --test scripts/a11y-static.test.mjs",
    "test:static": "npm run test:design && npm run test:a11y && npm run test:matching && npm run test:saved-search && npm run test:compare && npm run test:ops && npm run test:community && npm run test:hub",
    "test:visual": "node scripts/run-playwright.mjs tests/visual.spec.ts",
    "test:axe": "node scripts/run-playwright.mjs tests/a11y.spec.ts",
    "lint": "eslint src && npm run check:links && npm run test:static && npm run test:security",
    "test:matching": "node --test scripts/match-reasons.test.mjs",
    "test:saved-search": "node scripts/saved-search-summary.test.mjs",
    "test:compare": "node scripts/compare-insights.test.mjs",
    "test:ops": "node scripts/ops-insights.test.mjs",
    "test:community": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/community-catalog.test.mjs",
    "test:hub": "node scripts/community-hub.test.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
