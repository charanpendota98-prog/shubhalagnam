# Safe local-development template for Mana Vivaha.
# Copy this file to .env only for local use. All external integrations are
# disabled or dry-run by default. Set real values through a secret manager only
# after independently verifying ownership, consent, and the target environment.
# Never commit a populated .env file.

# Local URLs; replace only with an operator-controlled deployment domain.
SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_URL=http://backend:8000
API_BASE=http://backend:8000
CORS_ORIGINS=http://localhost:3000
YEAR=2026

# Telegram. No token, chat ID, or channel destination is provided here.
BOT_TOKEN=
BOT_USERNAME=
BOT_TOKEN_BACKUP=
BOT_TOKEN_ALERT=
BOT_POOL_JSON=
ADMIN_CHAT_ID=
CHANNELS=
# Optional exact destination map (JSON, keyed by registry key). Only use an
# owner-confirmed @username or -100… channel ID; invite links are not posting IDs.
TELEGRAM_CHANNEL_DESTINATIONS_JSON=

# Local runtime state. The production stack requires a durable named volume;
# see PRODUCTION-DEPLOY.md before setting these to a live data path.
DATABASE_URL=
TSAP_DB_FILE=
# Durable production path is provisioned inside the named data volume.
TSAP_TOKEN_VERSIONS_FILE=
MANA_VIVAHA_PERSISTENT_ROOT=
MANA_VIVAHA_STATE_DIR=
MANA_VIVAHA_MEDIA_DIR=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379
ENV=development

# Payment integrations are disabled until real credentials and merchant details
# are independently verified. Do not use invented payment references.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_VERIFY_CAPTURE=1
PAY_UPI_ID=
VENDOR_UPI_ID=
PAYMENT_UPI_ID=
PAYMENTS_LIVE=false
PAYMENT_AUTO_APPROVE=false

# Publishing is opt-in. This template cannot publish real messages.
AUTO_POST_ON_REGISTER=false
AUTO_POST_ON_APPROVAL=false
PUBLISH_DRY_RUN=true
PUBLISH_RETRIES=0
PUBLISH_RATE_LIMIT=1.2

# WhatsApp is disabled; never add sample recipients, phone numbers, or bridge IDs.
WHATSAPP_MODE=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TARGETS=
WA_INSTANCES=[]
WA_ENABLED=false
WA_MAX_ATTEMPTS=1
WA_MIN_GAP=120
WA_MAX_GAP=170
WA_MIN_GAP_INTEREST=60
WA_MAX_GAP_INTEREST=120
WA_MIN_GAP_OTP=25
WA_MAX_GAP_OTP=60
WA_BREAK_EVERY=6
WA_BREAK_MIN_MIN=8
WA_BREAK_MAX_MIN=20
WA_LONG_PAUSE_CHANCE=0.08
WA_DAILY_CAP=60
WA_TARGET_DAILY_CAP=8
WA_ACTIVE_START=8
WA_ACTIVE_END=22
WA_WARMUP_DAYS=4
WA_FAIL_COOLDOWN_MIN=30
WA_TEST_FAST=false

# Requests, review, and seeding. Synthetic records remain disabled.
INTEREST_MAX_PER_DAY=20
INTEREST_EXPIRY_DAYS=7
INTEREST_REFUND_ON_DECLINE=true
DEMO_SEED_ENABLED=false
LAUNCH_SEED_COUNT=0

# Operator-only contacts stay blank until real business contacts are supplied.
ADMIN_WHATSAPP_NUMBER=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
SUPPORT_PHONE=
VAPID_SUBJECT=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_CONTACT_NAME=
NEXT_PUBLIC_BUSINESS_LOCATION=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_LEGAL_NAME=

# Web Push secrets (optional; generate for the intended environment).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production/security settings. Generate unique secrets and provision named
# accounts before deployment; do not reuse example or development values.
APP_ENV=development
TSAP_AUTH_MODE=on
TSAP_API_KEY=
TSAP_AUTH_SECRET=
ADMIN_KEY=
STAFF_KEY=
JWT_SECRET=
OTP_CHANNELS=
SMS_ROUTE=
SMS_SENDER=
MSG91_KEY=
MSG91_TEMPLATE=
FAST2SMS_KEY=

# Private control portal: no demo accounts or demo credentials are supplied.
CONTROL_OWNER_USERNAME=
CONTROL_OWNER_PASSWORD_HASH=
CONTROL_WORKER_USERNAME=
CONTROL_WORKER_PASSWORD_HASH=
CONTROL_ACCOUNTS_JSON=
CONTROL_SESSION_TTL_SECONDS=28800
CONTROL_AUDIT_FILE=/tmp/manavivaha-control-audit.jsonl
CONTROL_ALLOW_PLAINTEXT_BOOTSTRAP=false
