# ============================================================
# MANA VIVAHA (TSAP Matrimony) — ENV TEMPLATE
# Copy: cp .env.example .env  → values fill chey → docker-compose up -d --build
# ============================================================

# ---- Brand / site ----
SITE_URL=https://manavivaha.in
YEAR=2025

# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=@telugumatrimony1_bot
ADMIN_CHAT_ID=123456789
CHANNELS=TSBRIDE,TSGROOM1
# Bot → backend URL (docker lo backend service; local test lo http://localhost:8000)
API_BASE=http://backend:8000

# ---- Payments (Razorpay) ----
# Dashboard: https://dashboard.razorpay.com/app/keys → TEST keys (rzp_test_...) tho start chey,
# KYC + live activate ayyaka LIVE keys (rzp_live_...) petti restart. Keys lekunte site
# automatic ga UPI-manual mode lo nadustundi (PAY_UPI_ID). Full steps: RAZORPAY-SETUP-TELUGU.md
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
# Webhook: dashboard → Settings → Webhooks → Add → URL = https://manavivaha.in/api/pay/webhook
# Events: payment.authorized + payment.captured + payment.failed + refund.processed
RAZORPAY_WEBHOOK_SECRET=whsec_xxxx
# Strict mode (optional): captured+amount verify ayithe thappa fulfill vaddhu (1 = ON, recommended)
RAZORPAY_VERIFY_CAPTURE=1
# Manual-UPI mode (keys lekapothe): dabbulu vellalsina UPI ID
PAY_UPI_ID=manavivaha@upi

# ---- DB / cache ----
DATABASE_URL=postgresql://tsap:tsap123@postgres:5432/tsap_matrimony
REDIS_URL=redis://redis:6379
ENV=production

# ---- AUTO-PUBLISH (register avvagane Telegram + WhatsApp ki post) ----
AUTO_POST_ON_REGISTER=true      # false ayithe approve tarvata matrame post
PUBLISH_DRY_RUN=false           # true ayithe post cheyyadu (test) — token lekapothe auto-true
PUBLISH_RETRIES=3               # per channel retries
PUBLISH_RATE_LIMIT=1.2          # seconds gap per channel (Telegram spam safe)

# ---- WhatsApp ----
# off | cloud_api | bridge
WHATSAPP_MODE=off

# Option A — Official Meta WhatsApp Business Cloud API (best for broadcast, opt-in users)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=9198480xxxxx,9197012xxxxx

# Option B — Local bridge (Baileys): groups/community ki post (QR scan once)
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001     # base URL (code '/send' suffix handle chestundi)
WHATSAPP_BRIDGE_TARGETS=120363xxxxxxxx@g.us,9198480xxxxx@s.whatsapp.net
PUBLIC_BASE_URL=https://manavivaha.in     # card image URL (bridge image fetch cheyyadaniki)

# ---- WHATSAPP ANTI-BAN + CONSENT (🛡️ random gaps + caps) ----
# Order: TELEGRAM post ayyaka → WhatsApp channels lane. Personal messages require user consent.
# OTP is transactional only; never include promotions in OTP templates.
WA_ENABLED=true
WA_MIN_GAP=120                  # prati WhatsApp post madhya minimum gap (seconds)
WA_MAX_GAP=170                  # maximum gap — random ga ee madhya untundi
WA_MIN_GAP_INTEREST=60          # interest/request messages ki fast lane
WA_MAX_GAP_INTEREST=120
WA_MIN_GAP_OTP=25
WA_MAX_GAP_OTP=60
WA_BREAK_EVERY=6                # prati 6 messages ki okasari pedda break
WA_BREAK_MIN_MIN=8              # break 8–20 min (manishi la)
WA_BREAK_MAX_MIN=20
WA_LONG_PAUSE_CHANCE=0.08       # 8% chance extra 3–8 min pause
WA_DAILY_CAP=60                 # rojuki total messages (warmup day-1 lo 33% matrame)
WA_TARGET_DAILY_CAP=8           # okate channel/group ki rojuki max
WA_ACTIVE_START=8               # 8AM (IST) nunchi
WA_ACTIVE_END=22                # 10PM (IST) varaku — raatri aapitam
WA_WARMUP_DAYS=4                # kotha number ramp: 33% → 55% → 75% → 100%
WA_FAIL_COOLDOWN_MIN=30         # 3 failures → 30 min auto-pause
WA_TEST_FAST=false              # true = gap 1–2 sec (ONLY tests)

# ---- INTEREST / REQUEST MODEL (🚫 chatting ledu) ----
INTEREST_MAX_PER_DAY=20         # oka user rojuki max requests (spam block)
INTEREST_EXPIRY_DAYS=7          # 7 days lo reply rakapothe auto expire
INTEREST_REFUND_ON_DECLINE=true # decline/withdraw aithe credit refund (trust)
PAYMENT_AUTO_APPROVE=true       # true = demo lo ventane credits; Razorpay live ayyaka false
DEMO_SEED_ENABLED=true          # startup lo 4 demo profiles (production lo false)

# ---- GROWTH: NAMASTE WELCOME + LEAD CAPTURE + LAUNCH INVENTORY ----
# ─── FAILOVER (okati fail aithe inkokati pampela) ─────────────────────────────
# Telegram bots — 3 recommended: primary (users+post) • backup (post) • alert (alerts)
#   Prathi bot ni CHANNELS lo ADMIN cheyyali (Post + Edit + Pin + Change Info)
BOT_TOKEN_BACKUP=                 # 2nd bot — primary fail/rate-limit aithe channels ki idi post chestundi
BOT_TOKEN_ALERT=                  # 3rd bot — admin alerts (namaste/interest/monitor) — rate limit valla aagakudadu
ADMIN_CHAT_ID=                    # alerts vellalsina chat id (mee private chat / admin group)
# BOT_POOL_JSON advanced: [{"name":"primary","token":"...","roles":["post","user"]},{"name":"backup","token":"...","roles":["post"]}]

# WhatsApp numbers — recommended 3 isolated lanes (each must be opt-in/legitimate)
# wa-otp: OTP only; wa-channels: approved channel/group posts only;
# wa-personal: consented personal interest/support DMs only. Never mix OTP and marketing.
# Each bridge is a separate session/QR and separate number. Do not automate unsolicited private messages.
WA_INSTANCES=[{"name":"wa-otp","url":"http://whatsapp-otp:3000","lane":"otp","daily_cap":120,"number":""},
              {"name":"wa-channels","url":"http://whatsapp-channels:3000","lane":"channels","daily_cap":60,"number":""},
              {"name":"wa-personal","url":"http://whatsapp-personal:3000","lane":"personal","daily_cap":40,"number":""}]
# If a lane is unavailable, add one explicitly as lane=both for failover; do not silently reuse OTP for marketing.
WA_MAX_ATTEMPTS=3                 # 3 tries (instances failover tho) → tarvata dead-letter + admin alert

ADMIN_WHATSAPP_NUMBER=          # admin/matcher WhatsApp — kotha registration alert ikkadiki (91XXXXXXXXXX)
SUPPORT_PHONE=9100000000        # trust line — profiles lo kanipisthundi
LAUNCH_SEED_COUNT=60            # startup lo launch inventory profiles (VM lo 360 pettandi, production lo 0)
LAUNCH_TARGET_PROFILES=360      # "300-400 profiles chalu" gauge target

# ---- Web Push (VAPID) — mobile app match alerts ----
# Generate (1 min, server lo): pip install pywebpush →
#   python -c "from pywebpush import generate_vapid_keys; import json; print(json.dumps(generate_vapid_keys()))"
# public key → VAPID_PUBLIC_KEY, private key → VAPID_PRIVATE_KEY. Lekunte preview mode (queue lone).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Frontend → backend proxy (docker service name) ----
BACKEND_URL=http://backend:8000

# ---- SECURITY / PROD (deploy ki MUST — lekunte site open ga untundi!) ----
# production mode refuses to boot when secrets are missing or default-like.
APP_ENV=development
# on = production (auth enforce). off/dev/test ayithe login/admin security AAGIPOTUNDI — tests ke!
TSAP_AUTH_MODE=on
# Bot automation private API key (backend + bot env lo SAME key) — long random (32+ chars)
TSAP_API_KEY=change-me-long-random-32chars
# Admin panel + /owner + backup download key — EVARIKI ivvakarledu
ADMIN_KEY=change-me-admin-random-32chars
# Limited worker key (never share with owner credentials)
STAFF_KEY=change-me-staff-random-32chars
# Login tokens sign key — random
JWT_SECRET=change-me-jwt-random-32chars
# Mee domain (CORS allow) — https tho
CORS_ORIGINS=https://manavivaha.in
PUBLIC_SITE_URL=https://manavivaha.in
# OTP provider order: whatsapp,sms or sms (production lo real provider mandatory)
OTP_CHANNELS=whatsapp,sms
OTP_DEV_MODE=false
SMS_ROUTE=msg91
SMS_SENDER=
MSG91_KEY=
MSG91_TEMPLATE=
FAST2SMS_KEY=
# Payments live switch (Razorpay live keys + webhook ayyaka true)
PAYMENTS_LIVE=true
# ---- PRIVATE CONTROL PORTAL (never expose these in frontend/localStorage) ----
# One private login at /control/login; role is assigned by the account record.
# Preferred: use CONTROL_ACCOUNTS_JSON with pre-generated password_hash values.
# Generate a hash: python -c "from backend.control_auth import password_hash; print(password_hash('your-14-plus-char-password'))"
CONTROL_OWNER_USERNAME=owner@example.com
CONTROL_OWNER_PASSWORD_HASH=
CONTROL_WORKER_USERNAME=worker@example.com
CONTROL_WORKER_PASSWORD_HASH=
# Optional JSON for multiple invited roles: {"worker":{"username":"...","password_hash":"..."}}
CONTROL_ACCOUNTS_JSON=
CONTROL_SESSION_TTL_SECONDS=28800
CONTROL_AUDIT_FILE=/var/lib/manavivaha/control-audit.jsonl
# Never enable plaintext bootstrap in production.
CONTROL_ALLOW_PLAINTEXT_BOOTSTRAP=false

# Support display (website footer/contact lo kanipistundi)
NEXT_PUBLIC_SUPPORT_PHONE=919100000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=919100000000
NEXT_PUBLIC_SUPPORT_EMAIL=care@manavivaha.in
